{
  "name": "fast-ncu",
  "version": "2.0.0",
  "description": "A fast npm-check-updates alternative for the common case",
  "type": "module",
  "bin": {
    "fast-ncu": "dist/cli.js",
    "fncu": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && bun build src/cli.ts src/index.ts --target=node --outdir=dist --splitting && tsc -p tsconfig.build.json",
    "smoke": "node dist/cli.js -v && node -e \"import('./dist/index.js').then(m=>{if(typeof m.checkUpdates!=='function')process.exit(1)})\"",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "prepublishOnly": "bun run build && bun run smoke"
  },
  "keywords": [
    "npm",
    "check",
    "updates",
    "ncu",
    "fast",
    "dependencies",
    "upgrade"
  ],
  "author": "Uchkun Rakhimov <uchkunrakhimov@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uchkunr/fast-ncu.git"
  },
  "homepage": "https://github.com/uchkunr/fast-ncu#readme",
  "bugs": "https://github.com/uchkunr/fast-ncu/issues",
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.7.1",
    "semver": "^7.8.5",
    "typescript": "^6.0.3"
  }
}
